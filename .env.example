# Copy to .env and fill in. Values for the mock are in the pack's data/README.md.
# Nothing in this file is committed; in production these come from the secret manager.

# Where the supplied pack lives (kb/, eval/, tools/). Default: repository root.
MSA_PACK_DIR=.

# Member/claims/benefits/grievance API (the mock) and the third-party directory.
MSA_API_BASE_URL=http://localhost:8090
MSA_DIRECTORY_BASE_URL=http://localhost:8090/directory/v3

# One bearer token per tenant: MSA_TOKEN_<TENANT_ID upper-case>.
MSA_TOKEN_PLAN_A=
MSA_TOKEN_PLAN_B=
MSA_DIRECTORY_API_KEY=

# Model provider: anthropic | openai (any OpenAI-compatible endpoint, incl. Ollama / vLLM / Azure).
MSA_LLM_PROVIDER=anthropic
MSA_LLM_MODEL=claude-haiku-5-5
# MSA_LLM_BASE_URL=http://localhost:11434/v1     # e.g. Ollama
# MSA_LLM_API_KEY=                               # or ANTHROPIC_API_KEY / OPENAI_API_KEY
# MSA_LLM_PRICE_IN_PER_MTOK=0.10                 # override the built-in price table
# MSA_LLM_PRICE_OUT_PER_MTOK=0.50

# Per-conversation budgets enforced by the gateway.
MSA_BUDGET_MAX_STEPS=40
MSA_BUDGET_MAX_COST_USD=0.10
MSA_BUDGET_TURN_DEADLINE_S=30

# Rep API keys for the HTTP API: JSON {"<key>": {"tenant": "plan_a", "rep_id": "rep-001"}}
MSA_REP_KEYS={}

# Key used to pseudonymise member ids in operational logs (HMAC). Rotate per environment.
MSA_LOG_HMAC_KEY=change-me
