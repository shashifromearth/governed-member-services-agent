# Copy to .env and fill in. Values for the mock are in the pack's data/README.md.
# Nothing in this file is committed; in production these come from the secret manager.

# Where the supplied pack lives (kb/, eval/, tools/). Default: repository root.
MSA_PACK_DIR=.

# Member/claims/benefits/grievance API (the mock) and the third-party directory.
# 127.0.0.1 rather than localhost: avoids a ~2 s IPv6 fallback per request on Windows.
MSA_API_BASE_URL=http://127.0.0.1:8090
MSA_DIRECTORY_BASE_URL=http://127.0.0.1:8090/directory/v3

# One bearer token per tenant: MSA_TOKEN_<TENANT_ID upper-case>.
MSA_TOKEN_PLAN_A=
MSA_TOKEN_PLAN_B=
MSA_DIRECTORY_API_KEY=

# ---- Model selection: local first ----
# With nothing set here the agent runs on a local open-weights model served by Ollama
# (MSA_LOCAL_MODEL, default qwen2.5:7b) and needs no account or API key.
# A hosted model is used ONLY if you supply its key: ANTHROPIC_API_KEY (-> claude-haiku-5-5),
# otherwise OPENAI_API_KEY (-> gpt-4o-mini). Leave both empty to stay fully local.
MSA_LLM_PROVIDER=auto
MSA_LOCAL_MODEL=qwen2.5:7b
# MSA_OLLAMA_URL=http://localhost:11434/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides:
# MSA_LLM_PROVIDER=ollama | anthropic | openai     # force a provider instead of auto-detecting
# MSA_LLM_MODEL=                                    # force a model name for the chosen provider
# MSA_LLM_BASE_URL=                                 # any OpenAI-compatible endpoint (vLLM, Azure, ...)
# MSA_LLM_PRICE_IN_PER_MTOK=  MSA_LLM_PRICE_OUT_PER_MTOK=   # prices for models not in the built-in table

# Per-conversation budgets enforced by the gateway.
MSA_BUDGET_MAX_STEPS=40
MSA_BUDGET_MAX_COST_USD=0.10
# MSA_BUDGET_TURN_DEADLINE_S=      # default: 30 s hosted, 3600 s local (CPU inference is slow)

# Rep API keys for the HTTP API: JSON {"<key>": {"tenant": "plan_a", "rep_id": "rep-001"}}
MSA_REP_KEYS={}

# Key used to pseudonymise member ids in operational logs (HMAC). Rotate per environment.
MSA_LOG_HMAC_KEY=change-me
